# Defaults for the compose stack (docker-compose.yml). Override any of them
# in `.env.compose` at the repository root, which is read after this file and
# is gitignored. Never put a secret value in either file: secrets are Docker
# secrets or files in the `personalos-secrets` volume (docs/CONTAINERS.md).
#
# The database, secret store, API token and collector wiring are set in
# docker-compose.yml itself and cannot be changed here.

APP_ENV=container
LOG_LEVEL=INFO
LOG_FORMAT=json

# Every route but /health needs the API token:
#   docker compose exec api python -m personalos.cli auth token
API_AUTH_ENABLED=true
# The UI (`--profile ui`) is served on http://localhost:5173.
API_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Traces go to the stack's collector (`docker compose logs otel-collector`).
TRACING_ENABLED=true
# Metrics go there too; `--profile monitoring` graphs and alerts on them
# (docs/METRICS.md). A workflow with nothing recorded for
# WORKFLOW_STALL_SECONDS fires WorkflowStalled.
METRICS_ENABLED=true
WORKFLOW_STALL_SECONDS=900

# The offline embedder, so the stack needs no model download. With
# `--profile ollama`, set EMBEDDING_PROVIDER=ollama and
# EMBEDDING_BASE_URL=http://ollama:11434 in .env.compose, then
# `docker compose exec ollama ollama pull nomic-embed-text`.
EMBEDDING_PROVIDER=hashing
CLOUD_INFERENCE_ALLOWED=false

# File tools reject every path until roots are mounted and listed here.
FILES_ALLOWED_ROOTS=[]
