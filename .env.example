# Database
DATABASE_URL=postgresql://user:password@localhost:5432/personalos
DATABASE_ECHO=false

# Redis (for job queue and caching)
REDIS_URL=redis://localhost:6379/0

# API Server
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=false
API_WORKERS=4

# Celery Worker
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Observability
LOG_LEVEL=INFO
JAEGER_ENABLED=false
JAEGER_HOST=localhost
JAEGER_PORT=6831

# MCP Servers
MCP_FILES_ENABLED=true
MCP_GOOGLE_ENABLED=false
MCP_JOBS_ENABLED=true

# Google Integration (if enabled)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# Application
APP_NAME=PersonalOS
APP_ENV=development
