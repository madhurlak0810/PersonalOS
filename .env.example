# Database
DATABASE_URL=postgresql://user:password@localhost:5432/personalos
DATABASE_ECHO=false

# Redis (for the MCP response cache)
REDIS_URL=redis://localhost:6379/0

# API Server. Unauthenticated until Phase L1: keep it on loopback.
API_HOST=127.0.0.1
API_PORT=8000
API_WORKERS=4

# Observability
LOG_LEVEL=INFO
# json (one object per line, with workflow_id/correlation_id) or text.
LOG_FORMAT=json
# Tracing: off by default. Point OTEL_EXPORTER_OTLP_ENDPOINT at an OTLP/HTTP
# collector (Jaeger all-in-one listens on http://localhost:4318).
TRACING_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=

# MCP Servers
MCP_FILES_ENABLED=true
# Gmail and Calendar tools. Connect an account first (`personalos.cli auth
# google`). GOOGLE_ACCOUNT picks one connected account by address; empty
# means the most recently connected one.
MCP_GOOGLE_ENABLED=false
GOOGLE_ACCOUNT=
# The IANA zone calendar events are written in (e.g. America/New_York).
# Required for interview scheduling to use Google Calendar; the server's own
# local zone is never used.
CALENDAR_TIME_ZONE=
CALENDAR_ID=primary
# Gmail recruiter inbox: the only mail PersonalOS ever looks at. Messages with
# one of these labels, or matching one of these Gmail searches, are classified;
# everything else is ignored and nothing of it is stored. Both empty = off.
GMAIL_RECRUITER_LABELS=[]
GMAIL_RECRUITER_QUERIES=[]
GMAIL_POLL_INTERVAL_SECONDS=300
GMAIL_BACKFILL_DAYS=14
GMAIL_INBOX_ACTOR=api

# File tools: the only directories the files server may read or write, as a
# JSON list of absolute paths. Relative tool paths resolve against the first.
# Leave empty and every file read/write is rejected. Hidden and credential
# directories (.ssh, .aws, browser profiles, ...) are denied even inside a root.
FILES_ALLOWED_ROOTS=[]

# Embedder for resume evidence (`ingest-resume`) and for the posting queries
# artifact prep retrieves evidence with. `hashing` is the local, deterministic
# default; empty leaves evidence retrieval unconfigured. Changing it means
# re-running `ingest-resume`.
EMBEDDING_PROVIDER=hashing

# Greenhouse boards to search, as JSON: board token -> employer name
GREENHOUSE_BOARDS={}

# Days without activity before an application is moved to STALLED, and how
# often (seconds) the stall monitor checks
APPLICATION_STALL_WINDOW_DAYS=14
APPLICATION_STALL_CHECK_INTERVAL_SECONDS=3600

# Credentials: where secrets are kept, never the secrets themselves.
# Refresh tokens, API keys and the OAuth client secret live in the OS keychain
# under SECRET_STORE_SERVICE; do not put any of them in this file.
SECRET_STORE_SERVICE=personalos
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET_REF=cred://google-oauth-client/default
# `testing` or `production`: the OAuth client's publishing status. An
# unverified app in Testing gets 7-day refresh tokens and only its listed test
# users can consent; see the quick start.
GOOGLE_OAUTH_PUBLISHING_STATUS=testing

# Application
APP_NAME=PersonalOS
APP_ENV=development
