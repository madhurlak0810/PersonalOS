    {"id": "ab-search-jobs-llm", "tool": "jobs.search_jobs", "origin": "llm", "mutating": false, "arguments": {"keywords": "platform"}, "consequential": false, "external_write": false},
    {"id": "ab-scrape-details", "tool": "jobs.scrape_job_details", "origin": "system", "mutating": false, "arguments": {"job_id": "nw-1"}, "consequential": false, "external_write": false},
    {"id": "ab-filter-jobs", "tool": "jobs.filter_jobs", "origin": "system", "mutating": false, "arguments": {"remote_only": true}, "consequential": false, "external_write": false},
    {"id": "ab-provider-search", "tool": "job_providers.search", "origin": "system", "mutating": false, "arguments": {"provider": "greenhouse"}, "consequential": false, "external_write": false},
    {"id": "ab-provider-get-job", "tool": "job_providers.get_job", "origin": "system", "mutating": false, "arguments": {"provider": "greenhouse", "source_job_id": "42"}, "consequential": false, "external_write": false},
    {"id": "ab-read-file", "tool": "files.read_file", "origin": "system", "mutating": false, "arguments": {"path": "resume.md"}, "consequential": false, "external_write": false},
    {"id": "ab-read-file-llm", "tool": "files.read_file", "origin": "llm", "mutating": false, "arguments": {"path": "resume.md"}, "consequential": false, "external_write": false},
    {"id": "ab-create-new-file", "tool": "files.write_file", "origin": "system", "mutating": true, "arguments": {"path": "drafts/cover-letter.md", "content": "Dear team"}, "consequential": false, "external_write": false},
    {"id": "ab-save-favorite", "tool": "jobs.save_favorite_job", "origin": "system", "mutating": true, "arguments": {"job_id": "nw-1"}, "consequential": false, "external_write": false},
    {"id": "ab-overwrite-guarded-write", "tool": "files.write_file", "origin": "system", "mutating": true, "arguments": {"path": "resume.md", "content": "new", "expected_sha256": "ab12"}, "consequential": true, "external_write": false},
    {"id": "ab-overwrite-document", "tool": "files.overwrite_document", "origin": "system", "mutating": true, "arguments": {"path": "resume.md", "content": "new", "expected_sha256": "ab12"}, "consequential": true, "external_write": false},
    {"id": "ab-overwrite-document-llm", "tool": "files.overwrite_document", "origin": "llm", "mutating": true, "arguments": {"path": "resume.md", "content": "new", "expected_sha256": "ab12"}, "consequential": true, "external_write": false},
    {"id": "ab-delete-file", "tool": "files.delete_file", "origin": "system", "mutating": true, "arguments": {"path": "resume.md"}, "consequential": true, "external_write": false},
    {"id": "ab-gmail-send", "tool": "google.gmail_send_message", "origin": "system", "mutating": true, "arguments": {"to": "priya@northwind.example"}, "consequential": true, "external_write": true},
