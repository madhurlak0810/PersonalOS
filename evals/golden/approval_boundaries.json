{
  "description": "Where approval belongs. `action_kinds` labels every graph-level ActionKind; `cases` are tool calls put to the default policy engine, each labelled with what a careful person would say about it: `consequential` (the action changes something the user would want to see first) and `external_write` (it reaches a system outside this one: a sent email, a submitted application, a calendar the user shares with others). Labels are ground truth and are never derived from the policy tables they are scored against. Synthetic.",
  "action_kinds": {
    "submit_application": {"consequential": true, "external_write": true},
    "send_recruiter_message": {"consequential": true, "external_write": true},
    "create_calendar_event": {"consequential": true, "external_write": true},
    "update_calendar_event": {"consequential": true, "external_write": true},
    "overwrite_document": {"consequential": true, "external_write": false}
  },
  "cases": [
