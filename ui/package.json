{
  "name": "personalos-ui",
  "private": true,
  "version": "0.1.0",
  "description": "PersonalOS operator UI: the approvals inbox, application board and workflow progress.",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "api:export": "python3 ../scripts/export_openapi.py",
    "api:generate": "openapi-typescript openapi.json --output src/api/schema.d.ts",
    "api:check": "python3 ../scripts/export_openapi.py --check && openapi-typescript openapi.json --check --output src/api/schema.d.ts"
  },
  "dependencies": {
    "openapi-fetch": "^0.17.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^27.0.0",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.1.0",
    "vitest": "^4.0.0"
  }
}
